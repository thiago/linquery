{
  "name": "linquery",
  "version": "0.2.0",
  "description": "A Django-inspired ORM for TypeScript with pluggable backends and offline-first support",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.mjs",
      "require": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:types": "tsd --files tests/type/**/*.test-d.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:run && npm run test:types",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run test:run && npm run lint"
  },
  "keywords": [
    "orm",
    "database",
    "typescript",
    "django",
    "graphql",
    "offline-first",
    "sync",
    "adapter"
  ],
  "author": "Thiago Rodrigues <thiagorsouz@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "tsd": "^0.33.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thiago/linquery.git"
  },
  "homepage": "https://github.com/thiago/linquery#readme",
  "bugs": {
    "url": "https://github.com/thiago/linquery/issues"
  }
}
